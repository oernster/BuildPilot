// The modal dialogs, drawn over the main window. Each opens focused on its first control,
// keeps the keyboard ring to its own controls while open and closes on Escape.

import { LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TextButton, Field, FieldLabel } from "widgets.slint";
import { StepEditor, StepsField, EnvironmentField, StepWarning } from "steps.slint";
import { HostsField } from "hosts.slint";

export component Modal inherits Rectangle {
    in property <length> panel-width: 560px;
    in property <string> heading;
    // A dialog of text to read: a fixed height, so its reading pane scrolls while the heading and
    // the buttons stay where they are (UI-011).
    in property <bool> tall;
    // The tall panel's height, kept clear of the window's edges.
    property <length> tall-height: min(root.height - 60px, 640px);
    // Escape was pressed: the dialog closes as its Cancel or Close would.
    callback dismissed();
    background: Theme.scrim;
    // Swallows clicks so nothing behind the dialog can be used while it is open.
    TouchArea { }
    // Wraps the panel, so Escape from any control in it passes through here.
    FocusScope {
        enabled: false;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }
        Rectangle {
            width: min(root.panel-width, root.width - 40px);
            height: root.tall ? root.tall-height : content.preferred-height;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            content := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: root.heading;
                    font-size: Theme.title-size;
                    font-weight: 600;
                    color: Theme.text;
                }
                @children
            }
        }
    }
}

// Add and Edit (SRS 3.2, 3.4).
export component OperationDialog inherits Modal {
    in-out property <string> name;
    in-out property <string> script;
    in-out property <string> working-dir;
    in-out property <string> arguments;
    in property <image> icon;
    in property <bool> icon-is-placeholder;
    in property <string> icon-note;
    in property <string> note;
    in property <string> error;
    in property <string> save-label: "Save";
    callback browse-script();
    callback browse-folder();
    callback choose-icon();
    callback use-placeholder-icon();
    callback save();
    callback cancel();

    dismissed => { root.cancel(); }
    init => { name-edit.focus(); }

    FieldLabel { text: name-field.label; }
    name-field := Field {
        focused: name-edit.has-focus;
        label: "Name";
        name-edit := LineEdit { text <=> root.name; accessible-label: name-field.label; }
    }
    FieldLabel { text: "Steps, run in order"; }
    if StepEditor.warning != "": StepWarning { }
    StepsField { }
    FieldLabel { text: script-field.label; }
    HorizontalLayout {
        spacing: Theme.gap;
        script-field := Field {
            focused: script-edit.has-focus;
            label: "Script of step " + (StepEditor.selected + 1);
            script-edit := LineEdit { text <=> root.script; accessible-label: script-field.label; }
        }
        TextButton {
            text: "Browse";
            label: "Browse for the script";
            in-dialog: true;
            clicked => { root.browse-script(); }
        }
    }
    FieldLabel { text: folder-field.label; }
    HorizontalLayout {
        spacing: Theme.gap;
        folder-field := Field {
            focused: folder-edit.has-focus;
            label: "Working directory";
            folder-edit := LineEdit {
                text <=> root.working-dir;
                accessible-label: folder-field.label;
            }
        }
        TextButton {
            text: "Browse";
            label: "Browse for the working directory";
            in-dialog: true;
            clicked => { root.browse-folder(); }
        }
    }
    if StepEditor.choose-environment: FieldLabel { text: "Environment"; }
    EnvironmentField { }
    FieldLabel { text: arguments-field.label; }
    arguments-field := Field {
        focused: arguments-edit.has-focus;
        label: "Arguments of step " + (StepEditor.selected + 1) + ", one per line";
        arguments-edit := TextEdit {
            text <=> root.arguments;
            height: 76px;
            accessible-label: arguments-field.label;
        }
    }
    FieldLabel { text: "Icon"; }
    HorizontalLayout {
        spacing: Theme.gap;
        Image {
            source: root.icon-is-placeholder
                ? @image-url("../assets/ui/application-icon.png") : root.icon;
            opacity: root.icon-is-placeholder ? Theme.dimmed : 1;
            width: 40px;
            height: 40px;
            image-fit: contain;
        }
        TextButton {
            text: "Choose image";
            icon: @image-url("../assets/ui/choose-change-application-icon.png");
            in-dialog: true;
            clicked => { root.choose-icon(); }
        }
        TextButton {
            text: "Use placeholder";
            in-dialog: true;
            clicked => { root.use-placeholder-icon(); }
        }
        Text {
            text: root.icon-note;
            color: Theme.text-muted;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
    if root.note != "": Text { text: root.note; color: Theme.caution; wrap: word-wrap; }
    if root.error != "": Text { text: root.error; color: Theme.failure; wrap: word-wrap; }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.gap;
        TextButton { text: "Cancel"; in-dialog: true; clicked => { root.cancel(); } }
        TextButton {
            text: root.save-label;
            primary: true;
            in-dialog: true;
            clicked => { root.save(); }
        }
    }
}

// A yes-or-no question (REM-001, STOP-004).
export component ConfirmDialog inherits Modal {
    in property <string> message;
    in property <string> confirm-label;
    callback confirm();
    callback cancel();
    panel-width: 460px;
    dismissed => { root.cancel(); }
    init => { cancel-button.focus-me(); }

    Text { text: root.message; color: Theme.text; wrap: word-wrap; }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.gap;
        cancel-button := TextButton {
            text: "Cancel";
            in-dialog: true;
            clicked => { root.cancel(); }
        }
        TextButton {
            text: root.confirm-label;
            primary: true;
            in-dialog: true;
            clicked => { root.confirm(); }
        }
    }
}

// Global options only (UI-004).
export component SettingsDialog inherits Modal {
    in property <string> data-folder;
    callback choose-theme(int);
    callback open-data-folder();
    callback close();
    heading: "Settings";
    panel-width: 560px;
    dismissed => { root.close(); }
    init => { light-button.focus-me(); }

    FieldLabel { text: "Theme"; }
    HorizontalLayout {
        spacing: Theme.gap;
        light-button := TextButton {
            text: "Light";
            label: "Light theme";
            in-dialog: true;
            checked: !Theme.dark;
            icon: @image-url("../assets/ui/light-mode.png");
            clicked => { root.choose-theme(0); }
        }
        TextButton {
            text: "Dark";
            label: "Dark theme";
            in-dialog: true;
            checked: Theme.dark;
            icon: @image-url("../assets/ui/dark-mode.png");
            clicked => { root.choose-theme(1); }
        }
    }
    FieldLabel { text: "Data folder"; }
    HorizontalLayout {
        spacing: Theme.gap;
        Text {
            text: root.data-folder;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        TextButton {
            text: "Open folder";
            label: "Open the data folder";
            in-dialog: true;
            clicked => { root.open-data-folder(); }
        }
    }
    FieldLabel { text: "Hosts for other script types"; }
    HostsField { }
    HorizontalLayout {
        alignment: end;
        TextButton { text: "Close"; primary: true; in-dialog: true; clicked => { root.close(); } }
    }
}
