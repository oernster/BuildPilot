// The main window (SRS 4 of the spec): toolbar, operation rows, output tray and the dialogs.
//
// Keyboard (A11Y-002, A11Y-003; the house model): the window opens with nothing focused. Tab and
// Right step forward round the ring, Shift+Tab and Left step back, both wrapping. The rows are one
// stop walked with Up and Down; the selected row's own controls follow it. While a dialog is open
// only its controls are stops.

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton, TextButton, Ring, TooltipLayer, Tooltip } from "widgets.slint";
import { RowData, StatusKind } from "row.slint";
import { RowsList } from "rows_list.slint";
import { OutputTray, OutputLineData, LineKind } from "tray.slint";
import { OperationDialog, ConfirmDialog, SettingsDialog } from "dialogs.slint";
import { HelpMenu, AboutDialog, LicenceDialog, UpdateDialog, CreditData } from "help.slint";
import { GuideDialog } from "guide.slint";
import { NoticeStrip } from "notices.slint";

export { Theme, RowData, StatusKind, OutputLineData, LineKind, Ring, CreditData }
export { SetupWindow, SetupScreen, FooterAction } from "setup.slint";
export { Reading } from "reading.slint";
export { StepEditor } from "steps.slint";
export { HostEditor } from "hosts.slint";
export { ScanList, ScannedRow } from "scan.slint";
import { ScanList, AddChoiceDialog, ScanListDialog } from "scan.slint";

// Which control opened the dialog that is showing, so focus can go back to it.
enum Opener { rows, add, settings, help }

export component MainWindow inherits Window {
    title: "BuildPilot";
    icon: @image-url("../assets/ui/application-icon.png");
    min-width: 760px;
    min-height: 480px;
    preferred-width: 1100px;
    preferred-height: 760px;
    background: Theme.background;

    in property <[RowData]> rows;
    // The selected row's position in `rows`; -1 when none is selected.
    in property <int> selected-index: -1;
    // A row is ticked, so Run ticked has something to run (ROW-006).
    in property <bool> any-checked;
    in property <[OutputLineData]> lines;
    in property <[string]> notices;
    in property <string> version;

    in property <string> tray-heading;
    in property <string> dropped-note;
    in property <bool> tray-expanded;
    in property <bool> following: true;
    in property <length> tray-height: 260px;

    in property <bool> show-operation-dialog;
    in property <string> operation-heading;
    in property <string> operation-save-label;
    in-out property <string> field-name;
    in-out property <string> field-script;
    in-out property <string> field-working-dir;
    in-out property <string> field-arguments;
    in property <image> field-icon;
    in property <bool> field-icon-is-placeholder;
    in property <string> field-icon-note;
    in property <string> operation-note;
    in property <string> operation-error;

    in property <bool> show-confirm;
    in property <string> confirm-heading;
    in property <string> confirm-message;
    in property <string> confirm-label;

    in property <bool> show-settings;
    in property <string> data-folder;

    // Help (UI-006 to UI-010): the menu, then whichever surface it opened.
    in-out property <bool> show-help-menu;
    in property <bool> show-guide;
    in property <bool> show-about;
    in property <bool> show-licence;
    in property <bool> show-update;
    in property <string> description;
    in property <string> author;
    in property <string> copyright;
    in property <string> repository;
    in property <[CreditData]> credits;
    in property <string> licence-text;
    in property <string> update-message;
    in property <bool> update-offer;

    callback add();
    callback toggle-theme();
    callback open-settings();
    // A Help menu entry was chosen: guide, about, licence or updates.
    callback help(string);
    callback close-help();
    callback open-repository();
    callback download-update();
    callback skip-update();
    callback close-update();
    callback dismiss-notice(int);

    callback select(string);
    callback toggle-checked(string);
    callback run(string);
    callback run-checked();
    callback stop(string);
    callback edit(string);
    callback open-script(string);
    callback locate-script(string);
    callback remove(string);
    callback move-up(string);
    callback move-down(string);
    callback move-to(string, int);

    callback toggle-tray();
    callback jump-to-latest();
    callback tray-scrolled(bool);
    callback resize-tray(length);

    callback browse-script();
    callback browse-folder();
    callback choose-icon();
    callback use-placeholder-icon();
    callback save-operation();
    callback cancel-operation();
    callback confirm();
    callback cancel-confirm();
    callback choose-theme(int);
    callback open-data-folder();
    callback close-settings();

    // Moves keyboard focus one stop round the ring: forward when true, back when false.
    callback step-ring(bool);

    public function scroll-output-to-end() {
        tray.scroll-to-end();
    }

    public function apply-theme(dark: bool) {
        Theme.dark = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    init => {
        Ring.window-width = self.width;
        Ring.window-height = self.height;
    }
    changed width => { Ring.window-width = self.width; }
    changed height => { Ring.window-height = self.height; }

    out property <bool> modal-open: root.show-operation-dialog || root.show-confirm
        || root.show-settings || root.show-help-menu || root.show-guide || root.show-about
        || root.show-licence || root.show-update || ScanList.choosing || ScanList.listing;
    // Only the topmost surface reads itself: the update prompt can arrive over a Help surface.
    property <bool> reading-active: !root.show-update;
    changed modal-open => {
        Ring.modal-open = self.modal-open;
        // The control under the pointer may now be covered or gone.
        TooltipLayer.shown = false;
        if (!self.modal-open) {
            root.return-focus();
        }
    }
    // The control a closing dialog hands focus back to.
    property <Opener> opener: Opener.add;

    function return-focus() {
        if (root.opener == Opener.settings) {
            settings-button.focus-me();
        } else if (root.opener == Opener.help) {
            help-button.focus-me();
        } else if (root.opener == Opener.rows && root.rows.length > 0) {
            rows-list.focus-list();
        } else {
            add-button.focus-me();
        }
    }

    // Left and Right step the ring wherever a control has not used them (Tab is Slint's own).
    FocusScope {
        enabled: false;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.modifiers.alt || event.modifiers.control) {
                return reject;
            }
            if (event.text == Key.RightArrow) {
                root.step-ring(true);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.step-ring(false);
                return accept;
            }
            return reject;
        }

        // The neutral start: holds focus when no control does, so the first Tab, Right, Shift+Tab
        // or Left enters the ring from here. Never a stop and never drawn.
        sink := FocusScope {
            width: 0;
            height: 0;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            init => { self.focus(); }
        }

        VerticalLayout {
            HorizontalLayout {
                padding: 10px;
                spacing: Theme.gap;
                add-button := IconButton {
                    icon: @image-url("../assets/ui/add.png");
                    label: "Add a build script";
                    tooltip-below: true;
                    activated => { root.opener = Opener.add; root.add(); }
                }
                IconButton {
                    icon: @image-url("../assets/ui/run.png");
                    label: "Run the ticked builds";
                    enabled: root.any-checked;
                    disabled-reason: "tick the rows to run first";
                    tooltip-below: true;
                    activated => { root.run-checked(); }
                }
                Text {
                    text: "BuildPilot";
                    font-size: Theme.title-size;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: Theme.dark ? @image-url("../assets/ui/light-mode.png")
                        : @image-url("../assets/ui/dark-mode.png");
                    label: Theme.dark ? "Switch to light theme" : "Switch to dark theme";
                    tooltip-below: true;
                    activated => { root.toggle-theme(); }
                }
                settings-button := IconButton {
                    icon: @image-url("../assets/ui/settings.png");
                    label: "Settings";
                    tooltip-below: true;
                    activated => { root.opener = Opener.settings; root.open-settings(); }
                }
                help-button := IconButton {
                    icon: @image-url("../assets/ui/help-about.png");
                    label: "Help";
                    tooltip-below: true;
                    activated => { root.opener = Opener.help; root.show-help-menu = true; }
                }
            }

            NoticeStrip {
                notices: root.notices;
                dismiss(n) => { root.dismiss-notice(n); }
            }

            rows-list := RowsList {
                vertical-stretch: 1;
                rows: root.rows;
                selected-index: root.selected-index;
                add => { root.opener = Opener.add; root.add(); }
                select(id) => { root.select(id); }
                toggle-checked(id) => { root.toggle-checked(id); }
                run(id) => { root.run(id); }
                stop(id) => { root.stop(id); }
                edit(id) => { root.opener = Opener.rows; root.edit(id); }
                open-script(id) => { root.open-script(id); }
                locate-script(id) => { root.locate-script(id); }
                remove(id) => { root.opener = Opener.rows; root.remove(id); }
                move-up(id) => { root.move-up(id); }
                move-down(id) => { root.move-down(id); }
                move-to(id, to) => { root.move-to(id, to); }
            }

            tray := OutputTray {
                height: root.tray-expanded ? root.tray-height : Theme.tray-header-height;
                lines: root.lines;
                heading: root.tray-heading;
                dropped-note: root.dropped-note;
                expanded: root.tray-expanded;
                following: root.following;
                toggle => { root.toggle-tray(); }
                jump-to-latest => { root.jump-to-latest(); }
                scrolled(at-end) => { root.tray-scrolled(at-end); }
                resize-by(delta) => { root.resize-tray(delta); }
            }
        }

        if root.show-operation-dialog: OperationDialog {
            heading: root.operation-heading;
            save-label: root.operation-save-label;
            name <=> root.field-name;
            script <=> root.field-script;
            working-dir <=> root.field-working-dir;
            arguments <=> root.field-arguments;
            icon: root.field-icon;
            icon-is-placeholder: root.field-icon-is-placeholder;
            icon-note: root.field-icon-note;
            note: root.operation-note;
            error: root.operation-error;
            browse-script => { root.browse-script(); }
            browse-folder => { root.browse-folder(); }
            choose-icon => { root.choose-icon(); }
            use-placeholder-icon => { root.use-placeholder-icon(); }
            save => { root.save-operation(); }
            cancel => { root.cancel-operation(); }
        }
        if root.show-confirm: ConfirmDialog {
            heading: root.confirm-heading;
            message: root.confirm-message;
            confirm-label: root.confirm-label;
            confirm => { root.confirm(); }
            cancel => { root.cancel-confirm(); }
        }
        if root.show-settings: SettingsDialog {
            data-folder: root.data-folder;
            choose-theme(choice) => { root.choose-theme(choice); }
            open-data-folder => { root.open-data-folder(); }
            close => { root.close-settings(); }
        }
        if root.show-help-menu: HelpMenu {
            anchor-right: help-button.absolute-position.x + help-button.width;
            anchor-bottom: help-button.absolute-position.y + help-button.height;
            choose(entry) => { root.show-help-menu = false; root.help(entry); }
            dismissed => { root.show-help-menu = false; }
            step(forward) => { root.step-ring(forward); }
        }
        if root.show-guide: GuideDialog {
            reading-active: root.reading-active;
            close => { root.close-help(); }
        }
        if root.show-about: AboutDialog {
            version: root.version;
            description: root.description;
            author: root.author;
            copyright: root.copyright;
            repository: root.repository;
            credits: root.credits;
            reading-active: root.reading-active;
            open-repository => { root.open-repository(); }
            close => { root.close-help(); }
        }
        if root.show-licence: LicenceDialog {
            licence-text: root.licence-text;
            reading-active: root.reading-active;
            close => { root.close-help(); }
        }
        if root.show-update: UpdateDialog {
            message: root.update-message;
            offer: root.update-offer;
            download => { root.download-update(); }
            skip => { root.skip-update(); }
            close => { root.close-update(); }
        }
        if ScanList.choosing: AddChoiceDialog { }
        if ScanList.listing: ScanListDialog { }
    }
    // Last, so over everything: no list clips it and nothing covers it.
    if TooltipLayer.shown: Tooltip { }
}
