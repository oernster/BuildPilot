// The operator's host table in Settings (HOST-001). The state lives in a global so the main
// window carries none of it; Rust fills it and answers the callbacks.

import { LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TextButton, Field, FieldLabel } from "widgets.slint";

// What runs with no host at all (LCH-001), one kind of project per row.
struct BuiltIn { kind: string, how: string }

export global HostEditor {
    // `.rb: C:\Ruby33\bin\ruby.exe -W0` per row, in table order.
    in property <[string]> rows;
    // The row being written: its file type, program and arguments one per line.
    in-out property <string> extension;
    in-out property <string> program;
    in-out property <string> arguments;
    // Why the last Add or Remove was refused; empty when it was not.
    in property <string> error;
    callback add();
    callback remove(int);
    callback browse();
}

export component HostsField inherits VerticalLayout {
    // The width of the first column of the built-in list, so the second lines up.
    property <length> kind-width: 150px;
    // The file type field: room for a short extension such as .rb or .lua.
    property <length> extension-width: 96px;
    property <[BuiltIn]> built-in: [
        { kind: "Go and Rust", how: "build.ps1 (or any .ps1), run by PowerShell" },
        { kind: "Python", how: ".py, inside the project's environment" },
        { kind: "Batch and executables", how: ".bat, .cmd, .exe and .com" },
    ];
    spacing: Theme.gap;
    Text {
        text: "Built in, with no host needed:";
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    VerticalLayout {
        spacing: Theme.gap / 2;
        padding-left: Theme.gap * 2;
        for entry in root.built-in: HorizontalLayout {
            spacing: Theme.gap;
            Text { text: entry.kind; color: Theme.text; font-weight: 600; width: root.kind-width; }
            Text { text: entry.how; color: Theme.text-muted; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }
    Text {
        text: HostEditor.rows.length == 0
            ? "A host runs any other type, such as .rb with ruby.exe. No hosts yet."
            : "A host runs any other type, such as .rb with ruby.exe.";
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    for row[index] in HostEditor.rows: HorizontalLayout {
        spacing: Theme.gap;
        Text {
            text: row;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        TextButton {
            text: "Remove";
            label: "Remove host " + row;
            in-dialog: true;
            clicked => { HostEditor.remove(index); }
        }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: stretch;
        VerticalLayout {
            spacing: Theme.gap / 2;
            FieldLabel { text: extension-field.label; }
            extension-field := Field {
                focused: extension-edit.has-focus;
                label: "File type";
                width: root.extension-width;
                extension-edit := LineEdit {
                    // The standard edit asks for 160px at least, which spilled out of this
                    // narrow box over the start of the Program field (measured).
                    min-width: 0;
                    text <=> HostEditor.extension;
                    placeholder-text: ".rb";
                    accessible-label: extension-field.label;
                }
            }
        }
        VerticalLayout {
            spacing: Theme.gap / 2;
            horizontal-stretch: 1;
            FieldLabel { text: program-field.label; }
            HorizontalLayout {
                spacing: Theme.gap;
                program-field := Field {
                    focused: program-edit.has-focus;
                    label: "Program";
                    program-edit := LineEdit {
                        text <=> HostEditor.program;
                        placeholder-text: "ruby.exe or its full path";
                        accessible-label: program-field.label;
                    }
                }
                TextButton {
                    text: "Browse";
                    label: "Browse for the host program";
                    in-dialog: true;
                    clicked => { HostEditor.browse(); }
                }
            }
        }
    }
    FieldLabel { text: arguments-field.label; }
    arguments-field := Field {
        focused: arguments-edit.has-focus;
        label: "Host arguments before the script, one per line";
        arguments-edit := TextEdit {
            text <=> HostEditor.arguments;
            height: 52px;
            accessible-label: arguments-field.label;
        }
    }
    if HostEditor.error != "": Text { text: HostEditor.error; color: Theme.failure; wrap: word-wrap; }
    HorizontalLayout {
        alignment: start;
        TextButton {
            text: "Add host";
            label: "Add this host to the table";
            in-dialog: true;
            clicked => { HostEditor.add(); }
        }
    }
}
