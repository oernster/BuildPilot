// The Guide (UI-007): every control as its own icon with its name and a line on what it does,
// then the rules behind BuildPilot's behaviour, then keyboard use at the foot. The words are data
// here; the dialog only lays them out. tests/structural.rs checks that every toolbar and row
// control is named.

import { Theme } from "theme.slint";
import { TextButton } from "widgets.slint";
import { Modal } from "dialogs.slint";
import { ReadingPane } from "reading.slint";

struct GuideEntry { icon: image, name: string, text: string }
struct GuideRule { title: string, text: string }

// A heading stands clear of the section above it; the first has nothing above.
component SectionHeading inherits VerticalLayout {
    in property <string> text;
    in property <bool> first;
    padding-top: root.first ? 0 : Theme.gap * 2;
    Text {
        text: root.text;
        font-size: Theme.body-size;
        font-weight: 600;
        color: Theme.text;
    }
}

component Entries inherits VerticalLayout {
    in property <[GuideEntry]> entries;
    spacing: 8px;
    for entry in root.entries: HorizontalLayout {
        spacing: 10px;
        Image {
            source: entry.icon;
            width: 30px;
            height: 30px;
            image-fit: contain;
        }
        Text {
            text: entry.name + ": " + entry.text;
            color: Theme.text;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

component Paragraph inherits Text {
    color: Theme.text-muted;
    wrap: word-wrap;
}

export component GuideDialog inherits Modal {
    in property <bool> reading-active: true;
    callback close();
    heading: "How BuildPilot works";
    panel-width: 720px;
    tall: true;
    dismissed => { root.close(); }
    init => { close-button.focus-me(); }

    property <[GuideEntry]> toolbar: [
        { icon: @image-url("../assets/ui/add.png"), name: "Add a build script",
          text: "choose a script (.ps1, .bat, .cmd, .exe, .com, .py or a type in your host table) or a folder. A folder holding build.ps1 (or buildexe.py then buildinstaller.py) is proposed as a build; a folder of projects lists each one to tick. Nothing is added until you confirm." },
        { icon: @image-url("../assets/ui/run.png"), name: "Run the ticked builds",
          text: "runs every ticked row at once, top first. One that cannot start (already running; another build using its folder) is named in a notice; the rest still run." },
        { icon: @image-url("../assets/ui/donate.png"), name: "Buy the author a drink (opens your browser)",
          text: "opens the donation page in your browser. BuildPilot is free and stays free: nothing is held back for a donation and BuildPilot sends nothing itself." },
        { icon: @image-url("../assets/ui/dark-mode.png"), name: "Switch to dark theme",
          text: "shown while BuildPilot is light; it turns BuildPilot dark. The toggle always shows the theme it switches into." },
        { icon: @image-url("../assets/ui/light-mode.png"), name: "Switch to light theme",
          text: "shown while BuildPilot is dark; it turns BuildPilot light. Settings holds the same choice." },
        { icon: @image-url("../assets/ui/settings.png"), name: "Settings",
          text: "the theme (Light or Dark), the folder BuildPilot keeps its settings and log in, then hosts: the program that runs each other script type, such as ruby.exe for .rb." },
        { icon: @image-url("../assets/ui/help-about.png"), name: "Help",
          text: "this guide, About, the licence and Check for Updates." },
    ];
    property <[GuideEntry]> row-controls: [
        { icon: @image-url("../assets/ui/reorder-rows.png"), name: "Drag to reorder",
          text: "drag a row by its handle to move it; the order is saved at once and never touches a run." },
        { icon: @image-url("../assets/ui/application-icon.png"), name: "Select",
          text: "the checkbox ticks a row for Run the ticked builds; click the row itself to show its output." },
        { icon: @image-url("../assets/ui/run.png"), name: "Run",
          text: "starts the row's steps in order, in its working directory with no console window; a .py or .ps1 step runs inside the project's Python environment when it has one. Greyed out while it is running and while another build is running in the same folder." },
        { icon: @image-url("../assets/ui/stop.png"), name: "Stop",
          text: "ends the running step and every process it started; no later step starts. Every other run is left alone." },
        { icon: @image-url("../assets/ui/launch-installer.png"), name: "Launch installer",
          text: "starts the project's setup program, as Explorer would. It is the one set in Edit; with none set, the folder's name plus Setup.exe in dist-installer, then in dist. Greyed out when there is none, while the row runs and after a run you stopped, until a run goes to the end." },
        { icon: @image-url("../assets/ui/edit-script.png"), name: "Edit",
          text: "change the name, the steps (add, remove or reorder them, each with its arguments), the working directory, the environment, the installer or the icon. BuildPilot never changes a script itself." },
        { icon: @image-url("../assets/ui/open-script.png"), name: "Open script",
          text: "opens the first step's script in whatever Windows opens that type of file with." },
        { icon: @image-url("../assets/ui/browse-locate-script.png"), name: "Show script in Explorer",
          text: "opens the first step's folder with its script selected." },
        { icon: @image-url("../assets/ui/negative.png"), name: "Remove",
          text: "takes the row out of BuildPilot after asking; its scripts stay where they are. Stop it first if it is running." },
    ];
    property <[GuideRule]> rules: [
        { title: "Output belongs to its row.",
          text: "The output tray at the foot shows the selected row's latest run, live while it runs and kept until it runs again or BuildPilot closes. It follows the newest line until you scroll up; Jump to latest takes you back. Beyond 100,000 lines the oldest go; the tray says so." },
        { title: "A run ends in its outcome.",
          text: "Output lines are plain whichever stream they came on, since many build tools report progress on stderr. When the run ends, one closing line gives the result: green for success, red for failure, grey when stopped. The exit code decides it." },
        { title: "Steps run in order.",
          text: "A row's steps run one after another. A step that fails stops the rest; every step's script is checked before the first one starts." },
        { title: "Several runs at once, one per folder.",
          text: "Each row runs on its own; starting or stopping one never touches another. Two builds never run in the same folder at once, since they would overwrite each other's output." },
        { title: "Python environments are used, never built.",
          text: "A .py or .ps1 step runs inside the virtual environment in its working directory; with several, Edit asks which. Any environment BuildPilot was started inside is undone first. BuildPilot never creates, installs into or repairs one." },
        { title: "New rows slot in by name.",
          text: "An added row goes in alphabetical order; a row you have moved stays where you put it. When rows are out of sight, the list says how many above and below." },
        { title: "Stop means the whole tree.",
          text: "Everything a script started ends with it. If anything is still alive five seconds later the row names its process ID." },
        { title: "Closing asks first.",
          text: "Closing BuildPilot with runs going names them and stops them only if you agree." },
        { title: "Your scripts are yours.",
          text: "BuildPilot never writes to, renames or deletes a script. It keeps its own list in buildpilot.json in the data folder that Settings names." },
        { title: "The only request it makes is the version check.",
          text: "Shortly after it opens and once a day, BuildPilot asks GitHub whether a newer release is published; Help > Check for Updates asks on demand. The request carries nothing about you or your scripts. A version you would rather not hear about again can be skipped." },
    ];

    ReadingPane {
        vertical-stretch: 1;
        label: "Guide";
        active: root.reading-active;
        VerticalLayout {
            spacing: 10px;
            padding-right: 16px;
            SectionHeading { text: "The bar along the top"; first: true; }
            Paragraph { text: "Hover any control to see its name."; }
            Entries { entries: root.toolbar; }
            SectionHeading { text: "Each row"; }
            Paragraph { text: "Left to right: the handle, the checkbox, the row's icon, its name and status, then its controls. A control that does not apply is greyed out, never hidden; its tooltip says why."; }
            Entries { entries: root.row-controls; }
            SectionHeading { text: "Rules behind the behaviour"; }
            for rule in root.rules: Text {
                text: rule.title + " " + rule.text;
                color: Theme.text;
                wrap: word-wrap;
            }
            SectionHeading { text: "Keyboard"; }
            Paragraph { text: "Tab and Shift+Tab move round every control, wrapping at both ends; Right and Left do the same. Space or Enter presses the focused control. A green ring marks it."; }
            Paragraph { text: "The rows are one stop: Up and Down choose a row, Space ticks its checkbox, Enter edits it and Alt+Up or Alt+Down moves it. The chosen row's own controls follow it round the ring."; }
            Paragraph { text: "In the output and in any text like this that reads itself, Up, Down, Page Up, Page Down, Home and End scroll. Close a dialog with its own buttons."; }
        }
    }
    HorizontalLayout {
        alignment: end;
        close-button := TextButton {
            text: "Close";
            primary: true;
            in-dialog: true;
            clicked => { root.close(); }
        }
    }
}
