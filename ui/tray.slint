// The live output tray at the foot of the window (SRS 3.10).
//
// The output is read from the keyboard by tabbing to it: a stop only while it has more lines
// than fit, reached by Tab alone (a click never focuses it) and never ringed, since it is text.
// Up, Down, Page Up, Page Down, Home and End scroll it.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TextButton, Ring } from "widgets.slint";
import { ScrollBar } from "scrollbar.slint";

// How a line is drawn (OUT-007): output in the plain text colour whichever stream it came on,
// since a tool that logs to stderr is not failing; a run's closing line in its outcome's colour.
export enum LineKind { plain, succeeded, failed, stopped }
export struct OutputLineData { text: string, kind: LineKind }

export component OutputTray inherits Rectangle {
    in property <[OutputLineData]> lines;
    in property <string> heading;
    in property <string> dropped-note;
    in property <bool> expanded;
    in property <bool> following: true;
    callback toggle();
    callback jump-to-latest();
    // The operator scrolled; the argument is true when the view reached the last line.
    callback scrolled(bool);
    // Drag on the top edge: the change in height asked for.
    callback resize-by(length);

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    // The height of one line of output, for scrolling by line.
    property <length> line-step: Theme.mono-size * 1.5;
    property <length> lowest: min(0px, list.visible-height - list.content-height);

    public function scroll-to-end() {
        list.content-y = root.lowest;
    }

    // While following, stay on the last line whenever the end moves. The list measures rows
    // added a moment ago only when it next lays out, after scroll-to-end has already run, so a
    // scroll asked for then stops short; a run's closing line, the last row added, stayed out of
    // sight (OUT-006).
    changed lowest => {
        if (root.following) {
            list.content-y = root.lowest;
        }
    }

    function scroll-to(y: length) {
        list.content-y = max(root.lowest, min(0px, y));
        root.scrolled(list.content-y <= root.lowest + 2px);
    }

    if root.expanded: TouchArea {
        y: 0;
        height: 5px;
        mouse-cursor: MouseCursor.row-resize;
        moved => { root.resize-by(self.pressed-y - self.mouse-y); }
    }

    VerticalLayout {
        HorizontalLayout {
            height: Theme.tray-header-height;
            padding: 2px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: Theme.gap;
            TextButton {
                text: root.expanded ? "Hide output" : "Show output";
                clicked => { root.toggle(); }
            }
            Text {
                text: root.heading;
                vertical-alignment: center;
                color: Theme.text;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.dropped-note;
                vertical-alignment: center;
                color: Theme.caution;
            }
            if root.expanded && !root.following: TextButton {
                text: "Jump to latest";
                clicked => { root.jump-to-latest(); }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            visible: root.expanded;
            output-stop := FocusScope {
                enabled: root.expanded && list.content-height > list.visible-height
                    && !Ring.modal-open;
                focus-on-click: false;
                focus-changed-event => {
                    if (self.has-focus) {
                        Ring.focused = "Output";
                    } else if (Ring.focused == "Output") {
                        Ring.focused = "";
                    }
                }
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        root.scroll-to(list.content-y + root.line-step);
                    } else if (event.text == Key.DownArrow) {
                        root.scroll-to(list.content-y - root.line-step);
                    } else if (event.text == Key.PageUp) {
                        root.scroll-to(list.content-y + list.visible-height);
                    } else if (event.text == Key.PageDown) {
                        root.scroll-to(list.content-y - list.visible-height);
                    } else if (event.text == Key.Home) {
                        root.scroll-to(0px);
                    } else if (event.text == Key.End) {
                        root.scroll-to(root.lowest);
                    } else {
                        return reject;
                    }
                    return accept;
                }
            }
            // The bar's strip is always kept: a line wider than the tray wraps rather than being
            // cut off, so the rows' height follows the list's width; a width that followed the bar
            // would be a loop.
            list := ListView {
                x: 0px;
                width: parent.width - output-bar.width;
                vertical-scrollbar-policy: always-off;
                scrolled => {
                    root.scrolled(self.content-y <= root.lowest + 2px);
                }
                for line in root.lines: HorizontalLayout {
                    padding-left: 6px;
                    Text {
                        text: line.text;
                        color: line.kind == LineKind.succeeded ? Theme.success
                            : line.kind == LineKind.failed ? Theme.failure
                            : line.kind == LineKind.stopped ? Theme.text-muted
                            : Theme.text;
                        font-weight: line.kind == LineKind.plain ? 400 : 600;
                        font-family: "Consolas";
                        font-size: Theme.mono-size;
                        wrap: word-wrap;
                    }
                }
            }
            // UI-012: a bar that shows whenever the output runs past the tray.
            output-bar := ScrollBar {
                x: parent.width - self.width;
                height: parent.height;
                content-height: list.content-height;
                visible-height: list.visible-height;
                content-y <=> list.content-y;
                scrolled => { root.scrolled(list.content-y <= root.lowest + 2px); }
            }
        }
    }
}
