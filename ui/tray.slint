// The live output tray at the foot of the window (SRS 3.10).
//
// The output is read from the keyboard by tabbing to it: a stop only while it has more lines
// than fit, reached by Tab alone (a click never focuses it) and never ringed, since it is text.
// Up, Down, Page Up, Page Down, Home and End scroll it.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TextButton, Ring } from "widgets.slint";

export struct OutputLineData { text: string, err: bool }

export component OutputTray inherits Rectangle {
    in property <[OutputLineData]> lines;
    in property <string> heading;
    in property <string> dropped-note;
    in property <bool> expanded;
    in property <bool> following: true;
    callback toggle();
    callback jump-to-latest();
    // The operator scrolled; the argument is true when the view reached the last line.
    callback scrolled(bool);
    // Drag on the top edge: the change in height asked for.
    callback resize-by(length);

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    // The height of one line of output, for scrolling by line.
    property <length> line-step: Theme.mono-size * 1.5;
    property <length> lowest: min(0px, list.visible-height - list.content-height);

    public function scroll-to-end() {
        list.content-y = root.lowest;
    }

    function scroll-to(y: length) {
        list.content-y = max(root.lowest, min(0px, y));
        root.scrolled(list.content-y <= root.lowest + 2px);
    }

    if root.expanded: TouchArea {
        y: 0;
        height: 5px;
        mouse-cursor: MouseCursor.row-resize;
        moved => { root.resize-by(self.pressed-y - self.mouse-y); }
    }

    VerticalLayout {
        HorizontalLayout {
            height: Theme.tray-header-height;
            padding: 2px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: Theme.gap;
            TextButton {
                text: root.expanded ? "Hide output" : "Show output";
                clicked => { root.toggle(); }
            }
            Text {
                text: root.heading;
                vertical-alignment: center;
                color: Theme.text;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.dropped-note;
                vertical-alignment: center;
                color: Theme.caution;
            }
            if root.expanded && !root.following: TextButton {
                text: "Jump to latest";
                clicked => { root.jump-to-latest(); }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            visible: root.expanded;
            output-stop := FocusScope {
                enabled: root.expanded && list.content-height > list.visible-height
                    && !Ring.modal-open;
                focus-on-click: false;
                focus-changed-event => {
                    if (self.has-focus) {
                        Ring.focused = "Output";
                    } else if (Ring.focused == "Output") {
                        Ring.focused = "";
                    }
                }
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        root.scroll-to(list.content-y + root.line-step);
                    } else if (event.text == Key.DownArrow) {
                        root.scroll-to(list.content-y - root.line-step);
                    } else if (event.text == Key.PageUp) {
                        root.scroll-to(list.content-y + list.visible-height);
                    } else if (event.text == Key.PageDown) {
                        root.scroll-to(list.content-y - list.visible-height);
                    } else if (event.text == Key.Home) {
                        root.scroll-to(0px);
                    } else if (event.text == Key.End) {
                        root.scroll-to(root.lowest);
                    } else {
                        return reject;
                    }
                    return accept;
                }
            }
            list := ListView {
                scrolled => {
                    root.scrolled(self.content-y <= root.lowest + 2px);
                }
                for line in root.lines: HorizontalLayout {
                    padding-left: 6px;
                    spacing: 4px;
                    Text {
                        width: 12px;
                        text: line.err ? "!" : "";
                        color: Theme.failure;
                        font-family: "Consolas";
                        font-size: Theme.mono-size;
                    }
                    Text {
                        text: line.text;
                        color: line.err ? Theme.failure : Theme.text;
                        font-family: "Consolas";
                        font-size: Theme.mono-size;
                    }
                }
            }
        }
    }
}
