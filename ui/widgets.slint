// The controls BuildPilot draws itself, so every one follows the house keyboard model
// (A11Y-001 to A11Y-004): a tooltip and an accessible name, Space and Enter activate, no ring at
// rest, a green ring while hovered or focused, a permanent red ring while disabled.

import { Theme } from "theme.slint";

// Keyboard state the whole window shares.
export global Ring {
    // True while a dialog is open: only the dialog's own controls are stops then.
    in-out property <bool> modal-open;
    // The label of the stop holding keyboard focus, for the tests; empty when none does.
    in-out property <string> focused;
    // The window's width, kept by the window, so a tooltip can stay inside it.
    in-out property <length> window-width;
}

// The ring's width, the same in every state so nothing moves when it appears.
export global RingMetrics {
    out property <length> width: 2px;
}

// The ring colour for a control in `enabled`, `hovered` and `focused`.
export global RingColour {
    pure public function of(enabled: bool, hovered: bool, focused: bool) -> color {
        if (!enabled) {
            return Theme.danger;
        }
        return hovered || focused ? Theme.ring : transparent;
    }
}

// Shown above or below a control while the pointer is on it: centred on the control, then moved
// along as far as it takes to stay inside the window at either end.
component Tooltip inherits Rectangle {
    in property <string> text;
    // Where the control starts across the window.
    in property <length> host-x;
    in property <length> host-width;
    in property <length> host-height;
    in property <bool> below;
    // The space kept between the tooltip and the control; the same between it and the window's edge.
    property <length> gap: 4px;
    y: root.below ? root.host-height + root.gap : -self.height - root.gap;
    x: max(
        root.gap - root.host-x,
        min((root.host-width - self.width) / 2,
            Ring.window-width - root.gap - self.width - root.host-x));
    width: tip.preferred-width + 16px;
    height: tip.preferred-height + 10px;
    border-radius: 4px;
    background: Theme.tooltip-background;
    tip := Text {
        text: root.text;
        color: Theme.tooltip-text;
        font-size: 12px;
    }
}

// What every stop shares: focus, activation by Space or Enter, reporting itself to `Ring`.
component Stop inherits FocusScope {
    // The name `Ring.focused` reports.
    in property <string> label;
    // False takes the stop off the ring without disabling it (a row that is not selected).
    in property <bool> on-ring: true;
    // True for a control inside a dialog, which stays a stop while the dialog is open.
    in property <bool> in-dialog;
    in property <bool> active: true;
    callback activated();

    enabled: root.active && root.on-ring && (root.in-dialog || !Ring.modal-open);
    focus-on-click: false;
    focus-changed-event => {
        if (self.has-focus) {
            Ring.focused = root.label;
        } else if (Ring.focused == root.label) {
            Ring.focused = "";
        }
    }
    key-pressed(event) => {
        if (event.text == " " || event.text == Key.Return) {
            root.activated();
            return accept;
        }
        return reject;
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    // Accessible name and tooltip text.
    in property <string> label;
    in property <bool> enabled: true;
    // Shown after the label in the tooltip while disabled.
    in property <string> disabled-reason;
    in property <bool> tooltip-below: false;
    in property <bool> on-ring: true;
    in property <bool> in-dialog;
    callback activated();

    public function focus-me() {
        stop.focus();
    }

    width: Theme.icon-button-size;
    height: Theme.icon-button-size;
    border-radius: Theme.radius;
    background: touch.has-hover && root.enabled ? Theme.surface-hover : transparent;
    border-width: RingMetrics.width;
    border-color: RingColour.of(root.enabled, touch.has-hover, stop.has-focus);
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.activated(); }

    Image {
        source: root.icon;
        width: parent.width * 0.72;
        height: parent.height * 0.72;
        image-fit: contain;
        opacity: root.enabled ? 1 : 0.3;
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => {
            if (root.enabled) {
                root.activated();
            }
        }
    }

    stop := Stop {
        label: root.label;
        active: root.enabled;
        on-ring: root.on-ring;
        in-dialog: root.in-dialog;
        activated => { root.activated(); }
    }

    if touch.has-hover: Tooltip {
        text: root.enabled || root.disabled-reason == ""
            ? root.label : root.label + ": " + root.disabled-reason;
        host-x: root.absolute-position.x;
        host-width: root.width;
        host-height: root.height;
        below: root.tooltip-below;
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    // The accessible name when it should say more than the text.
    in property <string> label: root.text;
    in property <image> icon;
    in property <bool> primary;
    // A destructive go-ahead: its words are in the danger colour.
    in property <bool> danger;
    // For a set of choices: this one is the current choice.
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> on-ring: true;
    in property <bool> in-dialog;
    callback clicked();

    public function focus-me() {
        stop.focus();
    }

    min-width: row.preferred-width + 24px;
    height: max(32px, row.preferred-height + 12px);
    border-radius: Theme.radius;
    background: root.primary && root.enabled ? Theme.accent
        : root.checked ? Theme.surface-selected
        : touch.has-hover && root.enabled ? Theme.surface-hover : Theme.background;
    border-width: RingMetrics.width;
    border-color: RingColour.of(root.enabled, touch.has-hover, stop.has-focus);
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checked;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }

    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 12px;
        padding-right: 12px;
        // A layout of its own holds the icon level with the words; left to the row, it sits at
        // the top of the button.
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            icon-image := Image {
                source: root.icon;
                width: 20px;
                height: 20px;
                image-fit: contain;
            }
        }
        words := Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.body-size;
            color: root.primary && root.enabled ? Theme.surface
                : root.danger && root.enabled ? Theme.danger
                : root.enabled ? Theme.text : Theme.text-muted;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    stop := Stop {
        label: root.label;
        active: root.enabled;
        on-ring: root.on-ring;
        in-dialog: root.in-dialog;
        activated => { root.clicked(); }
    }
}

// An address to open: its words in the accent, underlined, a stop wearing the house ring.
export component LinkText inherits Rectangle {
    in property <string> text;
    // The accessible name and tooltip; says where it goes.
    in property <string> label: root.text;
    in property <bool> in-dialog;
    callback clicked();

    width: words.preferred-width + 2 * RingMetrics.width + 4px;
    height: words.preferred-height + 2 * RingMetrics.width + 2px;
    border-radius: 3px;
    border-width: RingMetrics.width;
    border-color: RingColour.of(true, touch.has-hover, stop.has-focus);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    words := Text {
        text: root.text;
        color: Theme.accent;
    }
    // The underline that says it is a link.
    Rectangle {
        x: words.x;
        y: words.y + words.preferred-height - 1px;
        width: words.preferred-width;
        height: 1px;
        background: Theme.accent;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    stop := Stop {
        label: root.label;
        in-dialog: root.in-dialog;
        activated => { root.clicked(); }
    }
}

// One entry of a menu: its words at the left, the whole width to click, the house ring.
export component MenuItem inherits Rectangle {
    in property <string> text;
    callback clicked();

    public function focus-me() {
        stop.focus();
    }

    height: max(32px, words.preferred-height + 12px);
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    border-width: RingMetrics.width;
    border-color: RingColour.of(true, touch.has-hover, stop.has-focus);
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    words := Text {
        x: 12px;
        text: root.text;
        vertical-alignment: center;
        font-size: Theme.body-size;
        color: Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    stop := Stop {
        label: root.text;
        in-dialog: true;
        activated => { root.clicked(); }
    }
}

// A checkbox: a box that shows a tick when checked.
export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    in property <bool> on-ring: true;
    // A stop of an open dialog's ring rather than the main window's.
    in property <bool> in-dialog;
    callback toggled();

    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: root.checked ? Theme.accent : Theme.surface;
    border-width: RingMetrics.width;
    border-color: touch.has-hover || stop.has-focus ? Theme.ring : Theme.text-muted;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }

    if root.checked: Text {
        text: "\u{2713}";
        color: Theme.surface;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }

    stop := Stop {
        label: root.label;
        on-ring: root.on-ring;
        in-dialog: root.in-dialog;
        activated => { root.toggled(); }
    }
}

// A frame round a text input that rings it while hovered or focused; the input keeps its arrow
// keys for the caret and is left with Tab.
export component Field inherits Rectangle {
    in property <bool> focused;
    // The name `Ring.focused` reports while the input holds focus.
    in property <string> label;
    // A change handler only sees later changes, so an input focused as its dialog opens is
    // reported here instead.
    init => {
        if (root.focused) {
            Ring.focused = root.label;
        }
    }
    changed focused => {
        if (self.focused) {
            Ring.focused = root.label;
        } else if (Ring.focused == root.label) {
            Ring.focused = "";
        }
    }
    border-radius: Theme.radius;
    border-width: RingMetrics.width;
    border-color: RingColour.of(true, touch.has-hover, root.focused);
    touch := TouchArea { }
    HorizontalLayout {
        padding: RingMetrics.width;
        @children
    }
}
