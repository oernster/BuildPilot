// The one button BuildPilot uses: product artwork, a tooltip, an accessible name, keyboard
// activation, a visible focus ring and a disabled look that says why (A11Y-001 to A11Y-004).

import { Theme } from "theme.slint";

export component IconButton inherits Rectangle {
    in property <image> icon;
    // Accessible name and tooltip text.
    in property <string> label;
    in property <bool> enabled: true;
    // Shown after the label in the tooltip while disabled.
    in property <string> disabled-reason;
    in property <bool> tooltip-below: false;
    callback activated();

    width: Theme.icon-button-size;
    height: Theme.icon-button-size;
    border-radius: Theme.radius;
    background: touch.has-hover && root.enabled ? Theme.surface-hover : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;

    Image {
        source: root.icon;
        width: parent.width * 0.72;
        height: parent.height * 0.72;
        image-fit: contain;
        opacity: root.enabled ? 1 : 0.3;
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => {
            if (root.enabled) {
                focus.focus();
                root.activated();
            }
        }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (root.enabled && (event.text == " " || event.text == Key.Return)) {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    if touch.has-hover: Rectangle {
        y: root.tooltip-below ? root.height + 4px : -self.height - 4px;
        x: (root.width - self.width) / 2;
        width: tip.preferred-width + 16px;
        height: tip.preferred-height + 10px;
        border-radius: 4px;
        background: Theme.tooltip-background;
        tip := Text {
            text: root.enabled || root.disabled-reason == ""
                ? root.label : root.label + ": " + root.disabled-reason;
            color: Theme.tooltip-text;
            font-size: 12px;
        }
    }
}
